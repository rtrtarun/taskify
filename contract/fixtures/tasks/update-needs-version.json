{
  "description": "An update needs the expected version, in If-Match or in the body, and both must agree.",
  "rules": ["R3.3"],
  "steps": [
    {"request": {"method": "POST", "path": "/api/v1/tasks", "body": {"workspace_id": "{{workspace}}", "title": "Versioned"}},
      "expect": {"status": 201}, "capture": {"task": "id"}},
    {"name": "no version", "request": {"method": "PATCH", "path": "/api/v1/tasks/{{task}}", "body": {"title": "x"}},
      "expect": {"status": 428, "error_code": "version_required"}},
    {"name": "versions disagree", "request": {"method": "PATCH", "path": "/api/v1/tasks/{{task}}", "headers": {"If-Match": "\"1\""}, "body": {"version": 2, "title": "x"}},
      "expect": {"status": 400, "error_code": "invalid_request"}},
    {"name": "bad If-Match", "request": {"method": "PATCH", "path": "/api/v1/tasks/{{task}}", "headers": {"If-Match": "*"}, "body": {"title": "x"}},
      "expect": {"status": 400, "error_code": "invalid_request"}},
    {"name": "weak If-Match", "request": {"method": "PATCH", "path": "/api/v1/tasks/{{task}}", "headers": {"If-Match": "W/\"1\""}, "body": {"title": "Renamed"}},
      "expect": {"status": 200, "headers": {"ETag": "\"2\""}, "body": {"title": "Renamed", "version": 2}}},
    {"name": "version in the body, by PUT", "request": {"method": "PUT", "path": "/api/v1/tasks/{{task}}", "body": {"version": 2, "description": "Details"}},
      "expect": {"status": 200, "body": {"title": "Renamed", "description": "Details", "version": 3}}}
  ]
}
