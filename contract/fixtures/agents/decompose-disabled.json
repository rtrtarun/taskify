{
  "description": "With agents off for the workspace, asking for a decomposition is 409 agent_disabled and queues nothing.",
  "rules": ["R7.6"],
  "steps": [
    {"request": {"method": "POST", "path": "/api/v1/tasks", "body": {"workspace_id": "{{workspace}}", "title": "Too big"}}, "expect": {"status": 201}, "capture": {"task": "id"}},
    {"request": {"method": "POST", "path": "/api/v1/tasks/{{task}}/decompose"}, "expect": {"status": 409, "error_code": "agent_disabled"}},
    {"request": {"method": "GET", "path": "/api/v1/agent-jobs?task_id={{task}}"}, "expect": {"status": 200, "body": {"agent_jobs": []}}}
  ]
}
