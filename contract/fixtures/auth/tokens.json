{
  "description": "Missing, expired, wrongly signed, and malformed tokens are 401 with WWW-Authenticate.",
  "rules": ["R2.1"],
  "workspace": {"skip": true},
  "steps": [
    {"name": "none", "as": "none", "request": {"method": "GET", "path": "/api/v1/tasks"},
      "expect": {"status": 401, "error_code": "unauthorized", "headers": {"WWW-Authenticate": "Bearer realm=\"taskify\""}}},
    {"name": "expired", "as": "expired", "request": {"method": "GET", "path": "/api/v1/tasks"}, "expect": {"status": 401, "error_code": "unauthorized"}},
    {"name": "wrongly signed", "as": "bad_signature", "request": {"method": "GET", "path": "/api/v1/tasks"}, "expect": {"status": 401, "error_code": "unauthorized"}},
    {"name": "malformed", "as": "malformed", "request": {"method": "GET", "path": "/api/v1/tasks"}, "expect": {"status": 401, "error_code": "unauthorized"}},
    {"name": "valid", "request": {"method": "GET", "path": "/api/v1/tasks"}, "expect": {"status": 200, "body": {"tasks": []}}},
    {"name": "operations need none", "as": "none", "request": {"method": "GET", "path": "/healthz"}, "expect": {"status": 200, "body": {"status": "ok"}}}
  ]
}
