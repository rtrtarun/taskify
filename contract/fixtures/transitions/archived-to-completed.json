{
  "description": "archived to completed is not in the matrix (contract/RULES.md R4.1): 422 invalid_transition, and nothing changes.",
  "rules": ["R3.1", "R4.1", "R4.2"],
  "steps": [
    {"name": "create", "request": {"method": "POST", "path": "/api/v1/tasks", "body": {"workspace_id": "{{workspace}}", "title": "Matrix", "assignee_id": "usr_carol"}}, "expect": {"status": 201, "body": {"status": "todo", "version": 1}}, "capture": {"task": "id"}}, {"name": "move to archived", "request": {"method": "PATCH", "path": "/api/v1/tasks/{{task}}", "body": {"version": 1, "status": "archived"}}, "expect": {"status": 200, "body": {"status": "archived", "version": 2}}},
    {"name": "archived to completed", "request": {"method": "PATCH", "path": "/api/v1/tasks/{{task}}", "headers": {"If-Match": "\"2\""}, "body": {"status": "completed"}}, "expect": {"status": 422, "error_code": "invalid_transition"}, "outbox": {"rows": []}}, {"name": "unchanged", "request": {"method": "GET", "path": "/api/v1/tasks/{{task}}"}, "expect": {"status": 200, "body": {"status": "archived", "version": 2}}}
  ]
}
