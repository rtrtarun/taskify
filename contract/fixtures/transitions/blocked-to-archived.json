{
  "description": "blocked to archived is allowed (contract/RULES.md R4.1): the status changes and the version goes up by one.",
  "rules": ["R3.1", "R4.1", "R4.2"],
  "steps": [
    {"name": "create", "request": {"method": "POST", "path": "/api/v1/tasks", "body": {"workspace_id": "{{workspace}}", "title": "Matrix", "assignee_id": "usr_carol"}}, "expect": {"status": 201, "body": {"status": "todo", "version": 1}}, "capture": {"task": "id"}}, {"name": "move to blocked", "request": {"method": "PATCH", "path": "/api/v1/tasks/{{task}}", "body": {"version": 1, "status": "blocked"}}, "expect": {"status": 200, "body": {"status": "blocked", "version": 2}}},
    {"name": "blocked to archived", "request": {"method": "PATCH", "path": "/api/v1/tasks/{{task}}", "headers": {"If-Match": "\"2\""}, "body": {"status": "archived"}}, "expect": {"status": 200, "headers": {"ETag": "\"3\""}, "body": {"status": "archived", "version": 3, "archived_at": "$timestamp", "blocked_reason": null}}, "outbox": {"rows": []}}
  ]
}
