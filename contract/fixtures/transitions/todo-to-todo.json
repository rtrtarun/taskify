{
  "description": "Moving a todo task to todo is not a transition: the task comes back unchanged.",
  "rules": ["R3.1", "R4.1", "R4.2"],
  "steps": [
    {"name": "create", "request": {"method": "POST", "path": "/api/v1/tasks", "body": {"workspace_id": "{{workspace}}", "title": "Matrix", "assignee_id": "usr_carol"}}, "expect": {"status": 201, "body": {"status": "todo", "version": 1}}, "capture": {"task": "id"}},
    {"name": "todo to todo", "request": {"method": "PATCH", "path": "/api/v1/tasks/{{task}}", "headers": {"If-Match": "\"1\""}, "body": {"status": "todo"}}, "expect": {"status": 200, "headers": {"ETag": "\"1\""}, "body": {"status": "todo", "version": 1}}, "outbox": {"rows": []}}
  ]
}
