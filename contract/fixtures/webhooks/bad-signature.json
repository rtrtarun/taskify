{
  "description": "A callback without a valid signature is refused with 401 and changes nothing.",
  "rules": ["R8.1"],
  "steps": [
    {"request": {"method": "POST", "path": "/api/v1/tasks", "body": {"workspace_id": "{{workspace}}", "title": "Guarded"}}, "expect": {"status": 201}, "capture": {"task": "id"}},
    {"name": "another secret", "webhook": {"signature": "wrong", "body": {"action": "complete", "tenantId": "{{tenant}}", "userId": "usr_bob", "taskId": "{{task}}"}},
      "expect": {"status": 401, "error_code": "unauthorized"}},
    {"name": "malformed", "webhook": {"signature": "malformed", "body": {"action": "complete", "tenantId": "{{tenant}}", "userId": "usr_bob", "taskId": "{{task}}"}},
      "expect": {"status": 401, "error_code": "unauthorized"}},
    {"name": "missing", "webhook": {"signature": "missing", "body": {"action": "complete", "tenantId": "{{tenant}}", "userId": "usr_bob", "taskId": "{{task}}"}},
      "expect": {"status": 401, "error_code": "unauthorized"}},
    {"name": "unchanged", "request": {"method": "GET", "path": "/api/v1/tasks/{{task}}"}, "expect": {"status": 200, "body": {"status": "todo", "version": 1}}}
  ]
}
