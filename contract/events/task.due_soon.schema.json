{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task.due_soon",
  "description": "Sent to the assignee 24 hours and 1 hour before the due time. The body Taskify's outbox relay sends to AgentPulse's POST /v1/notify, camelCase. Key format and recipients: contract/RULES.md.",
  "type": "object",
  "properties": {
    "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 320},
    "tenantId": {"type": "string", "minLength": 1, "maxLength": 64},
    "userId": {"type": "string", "minLength": 1, "maxLength": 128, "description": "The recipient."},
    "source": {"enum": ["taskify"]},
    "eventType": {"enum": ["task.due_soon"]},
    "title": {"type": "string", "minLength": 1},
    "body": {"type": "string", "minLength": 1},
    "priorityHint": {"enum": ["critical", "high", "medium", "low"]},
    "channels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["slack", "email", "in_app", "webhook", "digest"]}, "description": "Absent to leave delivery to AgentPulse's rules; slack, email, and in_app with bypassDigest; digest alone for a deferred assignment."},
    "payload": {
      "type": "object",
      "properties": {
        "taskId": {"type": "string", "format": "uuid"},
        "workspaceId": {"type": "string", "minLength": 1},
        "status": {"enum": ["todo", "in_progress", "blocked", "completed", "archived"]},
        "priority": {"enum": ["p1_critical", "p2_high", "p3_medium", "p4_low"]},
        "labels": {"type": "array", "items": {"type": "string"}},
        "actorId": {"type": "string", "minLength": 1},
        "actorKind": {"enum": ["user", "agent", "system"]},
        "version": {"type": "integer", "minimum": 1},
        "previousStatus": {"enum": ["todo", "in_progress", "blocked", "completed", "archived"]},
        "dueAt": {"type": "string", "format": "date-time"},
        "bypassDigest": {"enum": [true]},
        "actionUrls": {"type": "object", "properties": {"complete": {"type": "string", "minLength": 1}, "snooze_2h": {"type": "string", "minLength": 1}, "view": {"type": "string", "minLength": 1}}, "additionalProperties": false, "description": "complete and snooze_2h while the task is open; view only with APP_BASE_URL."},
        "dueWindow": {"enum": ["24h", "1h"]}
      },
      "required": ["taskId", "workspaceId", "status", "priority", "labels", "actorId", "actorKind", "version", "dueWindow", "dueAt"],
      "additionalProperties": false
    }
  },
  "required": ["idempotencyKey", "tenantId", "userId", "source", "eventType", "title", "body", "priorityHint", "payload"],
  "additionalProperties": false
}
