{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "learning.suggestion",
  "description": "A learning suggestion, which the outbox relay sends to AgentPulse's POST /v1/learning/suggestions (D57).",
  "type": "object",
  "properties": {
    "tenantId": {"type": "string", "minLength": 1, "maxLength": 64},
    "eventPattern": {
      "type": "object",
      "properties": {
        "eventType": {"type": "string", "minLength": 1},
        "label": {"type": ["string", "null"]}
      },
      "required": ["eventType", "label"],
      "additionalProperties": false
    },
    "currentAdjustment": {"type": "integer", "minimum": -20, "maximum": 20},
    "proposedAdjustment": {"type": "integer", "minimum": -20, "maximum": 20},
    "signalCount": {"type": "integer", "minimum": 5},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 1000}
  },
  "required": ["tenantId", "eventPattern", "currentAdjustment", "proposedAdjustment", "signalCount", "rationale"],
  "additionalProperties": false
}
