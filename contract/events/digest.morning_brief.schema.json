{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "digest.morning_brief",
  "description": "A person's morning brief (D38, D39), digest only; the item urls only with APP_BASE_URL. The body Taskify's outbox relay sends to AgentPulse's POST /v1/notify, camelCase. Key format and recipients: contract/RULES.md.",
  "type": "object",
  "properties": {
    "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 320},
    "tenantId": {"type": "string", "minLength": 1, "maxLength": 64},
    "userId": {"type": "string", "minLength": 1, "maxLength": 128, "description": "The recipient."},
    "source": {"enum": ["taskify"]},
    "eventType": {"enum": ["digest.morning_brief"]},
    "title": {"type": "string", "minLength": 1},
    "body": {"type": "string", "minLength": 1},
    "priorityHint": {"enum": ["critical", "high", "medium", "low"]},
    "channels": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"enum": ["digest"]}},
    "payload": {
      "type": "object",
      "properties": {
        "jobId": {"type": "string", "format": "uuid"},
        "agentType": {"enum": ["digest"]},
        "briefDate": {"type": "string", "format": "date"},
        "digestSummary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "topItems": {"type": "array", "items": {
          "type": "object",
          "properties": {
            "taskId": {"type": "string", "format": "uuid"},
            "title": {"type": "string", "minLength": 1},
            "workspaceId": {"type": "string", "minLength": 1},
            "status": {"enum": ["todo", "in_progress", "blocked", "completed", "archived"]},
            "priority": {"enum": ["p1_critical", "p2_high", "p3_medium", "p4_low"]},
            "overdue": {"type": "boolean"},
            "dueAt": {"type": "string", "format": "date-time"},
            "url": {"type": "string", "minLength": 1}
          },
          "required": ["taskId", "title", "workspaceId", "status", "priority", "overdue"],
          "additionalProperties": false
        }},
        "openTasks": {"type": "integer", "minimum": 0},
        "pendingApprovals": {"type": "array", "items": {
          "type": "object",
          "properties": {
            "jobId": {"type": "string", "format": "uuid"},
            "agentType": {"enum": ["triage", "decomposer", "blocker_investigator", "digest", "learning"]},
            "taskId": {"type": "string", "format": "uuid"},
            "taskTitle": {"type": "string", "minLength": 1},
            "proposedTools": {"type": "array", "items": {"type": "string"}},
            "url": {"type": "string", "minLength": 1}
          },
          "required": ["jobId", "agentType", "taskId", "taskTitle", "proposedTools"],
          "additionalProperties": false
        }},
        "pendingApprovalsTotal": {"type": "integer", "minimum": 0},
        "unblockedTasks": {"type": "array", "items": {
          "type": "object",
          "properties": {
            "taskId": {"type": "string", "format": "uuid"},
            "title": {"type": "string", "minLength": 1},
            "workspaceId": {"type": "string", "minLength": 1},
            "status": {"enum": ["todo", "in_progress", "blocked", "completed", "archived"]},
            "priority": {"enum": ["p1_critical", "p2_high", "p3_medium", "p4_low"]},
            "overdue": {"type": "boolean"},
            "dueAt": {"type": "string", "format": "date-time"},
            "url": {"type": "string", "minLength": 1}
          },
          "required": ["taskId", "title", "workspaceId", "status", "priority", "overdue"],
          "additionalProperties": false
        }},
        "unblockedTotal": {"type": "integer", "minimum": 0},
        "actionUrls": {"type": "object", "properties": {"view": {"type": "string", "minLength": 1}}, "required": ["view"], "additionalProperties": false, "description": "Only with APP_BASE_URL."}
      },
      "required": ["jobId", "agentType", "briefDate", "digestSummary", "topItems", "openTasks", "pendingApprovals", "pendingApprovalsTotal", "unblockedTasks", "unblockedTotal"],
      "additionalProperties": false
    }
  },
  "required": ["idempotencyKey", "tenantId", "userId", "source", "eventType", "title", "body", "priorityHint", "payload", "channels"],
  "additionalProperties": false
}
