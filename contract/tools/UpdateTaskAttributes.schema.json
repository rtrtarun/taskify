{
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "format": "uuid",
      "description": "The task to update."
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      },
      "maxItems": 10,
      "uniqueItems": true,
      "description": "The complete label list."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "estimated_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 28800
    },
    "priority": {
      "enum": [
        "p1_critical",
        "p2_high",
        "p3_medium",
        "p4_low"
      ]
    },
    "reasoning": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "description": "Why, in one or two sentences, for the people reading the task."
    }
  },
  "required": [
    "task_id",
    "reasoning"
  ],
  "additionalProperties": false
}
